{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Linux Release（与 Makefile parity）",
            "binaryDir": "${sourceDir}/build-cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "displayName": "Linux Debug",
            "inherits": "default",
            "binaryDir": "${sourceDir}/build-cmake-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        }
    ]
}
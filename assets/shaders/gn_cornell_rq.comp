// gn_cornell_rq.comp — Cornell Box 的硬件光追预览（VK_KHR_ray_query）
//
// 与 gn_cornell_rt.comp（解析求交 compute）同一套光照公式与累积策略，区别是
// 主射线/阴影射线/反射射线都走 TLAS ray query；命中后按 primitive 索引取
// 三角形元数据（顶点下标 + 材质），用重心坐标插值法线（球面平滑）。
//
// 布局契约（与 cornellGpuRt.cpp / cornellRtAs.cpp 一致）：
//   set 0 binding 0 = outPixels (uint RGBA8)
//   set 0 binding 1 = scene     (vec4 数组；材质在 [quad*4+sphere*2 + mat*2])
//   set 0 binding 2 = params    (std140，同 gn_cornell_rt.comp)
//   set 0 binding 3 = accum     (vec4 样本和 + 样本数)
//   set 0 binding 4 = tlas      (accelerationStructureEXT)
//   set 0 binding 5 = positions (vec4 数组)
//   set 0 binding 6 = normals   (vec4 数组)
//   set 0 binding 7 = triMeta   (uvec4：i0,i1,i2,material)
#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) writeonly buffer OutPixels { uint pixels[]; } outBuf;
layout(set = 0, binding = 1) readonly buffer SceneData { vec4 data[]; } sceneData;
layout(set = 0, binding = 2) uniform RtParams {
    vec4 eye;
    vec4 fwd;
    vec4 camRight;
    vec4 camUp;
    vec4 cam;      // x=tanHalfFov, y=aspect, z=lightMode, w=sampleCount
    vec4 size;     // x=width, y=height
    vec4 sunDir;
    vec4 lightPos;
    uvec4 counts;  // x=quadCount, y=sphereCount, z=materialCount
    vec4 accumParams; // x=frameStartSample, y=reset
} u;
layout(set = 0, binding = 3) buffer AccumData { vec4 accum[]; } accumData;
layout(set = 0, binding = 4) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 5) readonly buffer Positions { vec4 positions[]; } posData;
layout(set = 0, binding = 6) readonly buffer Normals { vec4 normals[]; } normData;
layout(set = 0, binding = 7) readonly buffer TriMeta { uvec4 meta[]; } metaData;

const float PI = 3.14159265359;
const float EPS = 1.0e-4;
const int PT_BOUNCES = 3;

struct Hit {
    float t;
    vec3 normal;
    int material;
    bool valid;
};

uint rngStep(inout uint state) {
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return state;
}

float rnd(inout uint state) {
    return float(rngStep(state) & 0x00FFFFFFu) / 16777216.0;
}

vec3 skyColor(vec3 dir) {
    const float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    const vec3 horizon = vec3(0.62, 0.70, 0.82);
    const vec3 zenith = vec3(0.12, 0.30, 0.68);
    return mix(horizon, zenith, t);
}

vec3 cosineDir(vec3 n, inout uint state) {
    const float r1 = rnd(state);
    const float r2 = rnd(state);
    const float phi = 2.0 * PI * r2;
    const float radius = sqrt(r1);
    const float z = sqrt(max(0.0, 1.0 - r1));
    const vec3 up = abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3 t = normalize(cross(up, n));
    const vec3 b = cross(n, t);
    return normalize(t * cos(phi) * radius + b * sin(phi) * radius + n * z);
}

uint materialBase(int material) {
    return u.counts.x * 4u + u.counts.y * 2u + uint(material) * 2u;
}

// 一次 ray query；返回最近命中（committed）。阴影射线走 occluded()。
Hit trace(vec3 ro, vec3 rd, float tMax) {
    Hit hit;
    hit.valid = false;
    hit.t = tMax;
    hit.normal = vec3(0.0);
    hit.material = 0;
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, ro, EPS, rd, tMax);
    while (rayQueryProceedEXT(rq)) {
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return hit;
    }
    hit.t = rayQueryGetIntersectionTEXT(rq, true);
    const uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    const uvec4 tri = metaData.meta[primitive];
    const vec3 p0 = posData.positions[tri.x].xyz;
    const vec3 p1 = posData.positions[tri.y].xyz;
    const vec3 p2 = posData.positions[tri.z].xyz;
    const vec3 hp = ro + rd * hit.t;
    const vec3 e0 = p1 - p0;
    const vec3 e1 = p2 - p0;
    const vec3 ep = hp - p0;
    const float d00 = dot(e0, e0);
    const float d01 = dot(e0, e1);
    const float d11 = dot(e1, e1);
    const float d20 = dot(ep, e0);
    const float d21 = dot(ep, e1);
    const float denom = d00 * d11 - d01 * d01;
    vec3 n;
    if (abs(denom) > 1.0e-12) {
        const float bv = (d11 * d20 - d01 * d21) / denom;
        const float bw = (d00 * d21 - d01 * d20) / denom;
        const float bu = 1.0 - bv - bw;
        n = normalize(normData.normals[tri.x].xyz * bu + normData.normals[tri.y].xyz * bv +
                      normData.normals[tri.z].xyz * bw);
    } else {
        n = normalize(cross(e0, e1));
    }
    if (dot(n, rd) > 0.0) n = -n;
    hit.normal = n;
    hit.material = int(tri.w);
    hit.valid = true;
    return hit;
}

bool occluded(vec3 ro, vec3 rd, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF,
                          ro, EPS, rd, tMax);
    while (rayQueryProceedEXT(rq)) {
    }
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 shadeDirect(Hit hit, vec3 p, int lightMode) {
    const vec3 albedo = sceneData.data[materialBase(hit.material) + 0u].xyz;
    const vec3 fill = albedo * skyColor(hit.normal) * 0.22;
    vec3 result = vec3(0.0);
    if (lightMode == 0) {
        const vec3 toLight = normalize(-u.sunDir.xyz);
        const float ndl = dot(hit.normal, toLight);
        if (ndl <= 0.0) return fill;
        result = albedo * (ndl / PI * 3.0);
    } else {
        const vec3 toLight = u.lightPos.xyz - p;
        const float dist = length(toLight);
        if (dist <= EPS) return fill;
        const vec3 l = toLight / dist;
        const float ndl = dot(hit.normal, l);
        if (ndl <= 0.0) return fill;
        if (occluded(p + hit.normal * (EPS * 10.0), l, dist - EPS)) return fill;
        const float range = 9.0;
        const float att = 1.0 / (1.0 + 2.0 / range * dist + 1.0 / (range * range) * dist * dist);
        result = albedo * (ndl / PI * 14.0 * att);
    }
    return result + fill;
}

vec3 radiance(vec3 ro, vec3 rd, int lightMode, inout uint state) {
    vec3 result = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 currentOrigin = ro;
    vec3 currentDir = rd;
    for (int bounce = 0; bounce < PT_BOUNCES; ++bounce) {
        const Hit hit = trace(currentOrigin, currentDir, 1.0e30);
        if (!hit.valid) {
            result += throughput * skyColor(currentDir);
            break;
        }
        const vec3 p = currentOrigin + currentDir * hit.t;
        const vec3 albedo = sceneData.data[materialBase(hit.material) + 0u].xyz;
        const float metallic = sceneData.data[materialBase(hit.material) + 0u].w;
        if (metallic > 0.5) {
            currentOrigin = p + hit.normal * (EPS * 10.0);
            currentDir = normalize(reflect(currentDir, hit.normal));
            throughput *= albedo;
            continue;
        }
        result += throughput * shadeDirect(hit, p, lightMode);
        currentOrigin = p + hit.normal * (EPS * 10.0);
        currentDir = cosineDir(hit.normal, state);
        throughput *= albedo;
        if (bounce >= 2) {
            const float survive = 0.8;
            if (rnd(state) > survive) break;
            throughput *= 1.0 / survive;
        }
    }
    return result;
}

float toLinearByte(float value) {
    value = (value * (2.51 * value + 0.03)) / (value * (2.43 * value + 0.59) + 0.14);
    value = clamp(value, 0.0, 1.0);
    return pow(value, 1.0 / 2.2);
}

uint packRgba(vec3 color) {
    const uint r = uint(toLinearByte(color.r) * 255.0 + 0.5);
    const uint g = uint(toLinearByte(color.g) * 255.0 + 0.5);
    const uint b = uint(toLinearByte(color.b) * 255.0 + 0.5);
    return r | (g << 8) | (b << 16) | (255u << 24);
}

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const int width = int(u.size.x);
    const int height = int(u.size.y);
    if (int(pixel.x) >= width || int(pixel.y) >= height) return;

    const vec3 eye = u.eye.xyz;
    const vec3 forward = normalize(u.fwd.xyz);
    const vec3 rightDir = normalize(u.camRight.xyz);
    const vec3 upDir = normalize(u.camUp.xyz);
    const float tanHalf = u.cam.x;
    const float aspect = u.cam.y;
    const int lightMode = int(u.cam.z);
    const int sampleCount = int(u.cam.w);

    const float uu = (float(pixel.x) + 0.5) / float(width);
    const float vv = (float(pixel.y) + 0.5) / float(height);
    const vec3 dir = normalize(forward + rightDir * ((2.0 * uu - 1.0) * tanHalf * aspect) +
                               upDir * ((1.0 - 2.0 * vv) * tanHalf));

    const uint pixelIndex = pixel.y * uint(width) + pixel.x;
    if (u.accumParams.y > 0.5) accumData.accum[pixelIndex] = vec4(0.0);
    vec3 sum = accumData.accum[pixelIndex].rgb;
    float count = accumData.accum[pixelIndex].w;
    const uint seed = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + 17u;
    const uint frameStart = uint(u.accumParams.x);
    for (int s = 0; s < sampleCount; ++s) {
        uint state = seed + (frameStart + uint(s)) * 0x9E3779B9u;
        if (state == 0u) state = 1u;
        sum += radiance(eye, dir, lightMode, state);
        count += 1.0;
    }
    accumData.accum[pixelIndex] = vec4(sum, count);
    outBuf.pixels[pixelIndex] = packRgba(count > 0.0 ? sum / count : vec3(0.0));
}

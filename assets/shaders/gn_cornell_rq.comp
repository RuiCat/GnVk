// gn_cornell_rq.comp — Cornell Box 的硬件光追预览（VK_KHR_ray_query）
//
// 与 gn_cornell_rt.comp（解析求交 compute）同一套光照公式与累积策略，区别是
// 主射线/阴影射线/反射射线都走 TLAS ray query；命中后按 primitive 索引取
// 三角形元数据（顶点下标 + 材质），用重心坐标插值法线（球面平滑）。
//
// 布局契约（与 cornellGpuRt.cpp / cornellRtAs.cpp 一致）：
//   set 0 binding 0 = outPixels (uint RGBA8)
//   set 0 binding 1 = scene     (vec4 数组；材质在 [quad*4+sphere*2 + mat*2])
//   set 0 binding 2 = params    (std140，同 gn_cornell_rt.comp)
//   set 0 binding 3 = accum     (vec4 样本和 + 样本数)
//   set 0 binding 4 = tlas      (accelerationStructureEXT)
//   set 0 binding 5 = positions (vec4 数组)
//   set 0 binding 6 = normals   (vec4 数组)
//   set 0 binding 7 = triMeta   (uvec4：i0,i1,i2,material)
#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) writeonly buffer OutPixels { uint pixels[]; } outBuf;
layout(set = 0, binding = 1) readonly buffer SceneData { vec4 data[]; } sceneData;
layout(set = 0, binding = 2) uniform RtParams {
    vec4 eye;
    vec4 fwd;
    vec4 camRight;
    vec4 camUp;
    vec4 cam;      // x=tanHalfFov, y=aspect, z=lightMode, w=sampleCount
    vec4 size;     // x=width, y=height
    vec4 sunDir;
    vec4 lightPos;
    uvec4 counts;  // x=quadCount, y=sphereCount, z=materialCount
    vec4 accumParams; // x=frameStartSample, y=reset
    vec4 prevEye;
    vec4 prevFwd;
    vec4 prevRight;
    vec4 prevUp;
    vec4 temporal; // x=historyValid, y=moving, z=targetSamples
} u;
layout(set = 0, binding = 3) readonly buffer HistoryColorIn { vec4 historyColorIn[]; } historyIn;
layout(set = 0, binding = 8) writeonly buffer HistoryColorOut { vec4 historyColorOut[]; } historyOut;
layout(set = 0, binding = 9) readonly buffer HistoryDepthIn { float historyDepthIn[]; } depthIn;
layout(set = 0, binding = 10) writeonly buffer HistoryDepthOut { float historyDepthOut[]; } depthOut;

layout(std140, binding = 11) uniform PROBE_UBO {
    vec4 origin;        // xyz = 网格原点
    vec4 spacingCounts; // x=spacing, yzw=counts
    vec4 weight;        // x=强度（0=关）
} probe;
layout(std430, binding = 12) readonly buffer ProbeSh { vec4 probeSh[]; } probeData;
layout(std430, binding = 13) readonly buffer ProbeDepth { vec2 probeDepthMoments[]; } probeDepthData;
layout(std430, binding = 14) readonly buffer ProbeOffset { vec4 probeOffsets[]; } probeOffsetData;

vec3 evalProbeSh(vec3 wp, vec3 n) {
    // B3a：weight.z = normalBias（世界单位，沿表面法线偏移查询点）；weight.w 预留给 viewBias。
    const float normalBias = max(probe.weight.z, 0.0);
    const vec3 wpB = wp + n * normalBias;
    vec3 counts = max(probe.spacingCounts.yzw, vec3(1.0));
    vec3 grid = (wpB - probe.origin.xyz) / max(probe.spacingCounts.x, 1.0e-6);
    grid = clamp(grid, vec3(0.0), counts - vec3(1.0));
    ivec3 i0 = ivec3(floor(grid));
    ivec3 i1 = min(i0 + 1, ivec3(counts) - 1);
    vec3 f = fract(grid);
    vec4 c[9];
    for (int k = 0; k < 9; ++k) c[k] = vec4(0.0);
    const int cx = int(counts.x);
    const int cy = int(counts.y);
    float wsum = 0.0;
    for (int dz = 0; dz < 2; ++dz) {
        for (int dy = 0; dy < 2; ++dy) {
            for (int dx = 0; dx < 2; ++dx) {
                float w = (dx == 0 ? 1.0 - f.x : f.x) *
                          (dy == 0 ? 1.0 - f.y : f.y) *
                          (dz == 0 ? 1.0 - f.z : f.z);
                const int px = dx == 0 ? i0.x : i1.x;
                const int py = dy == 0 ? i0.y : i1.y;
                const int pz = dz == 0 ? i0.z : i1.z;
                const int probeIndex = (pz * cy + py) * cx + px;
                const vec3 basePos = probe.origin.xyz + probe.spacingCounts.x *
                                    vec3(float(px), float(py), float(pz));
                const vec3 probePos = basePos + probeOffsetData.probeOffsets[probeIndex].xyz;
                // 背面探针（探针在表面背面）降权，减少墙角/球体轮廓的跨面串色。
                if (dot(probePos - wpB, n) <= 0.0) w *= 0.5;
                const vec3 toSurface = wpB - probePos;
                const float dist = length(toSurface);
                const vec3 d = toSurface / max(dist, 1.0e-6);
                const vec3 a = abs(d);
                int face = 4;
                float u = 0.0;
                float v = 0.0;
                if (a.x >= a.y && a.x >= a.z) {
                    if (d.x >= 0.0) {
                        face = 0;
                        u = -d.z / a.x;
                        v = -d.y / a.x;
                    } else {
                        face = 1;
                        u = d.z / a.x;
                        v = -d.y / a.x;
                    }
                } else if (a.y >= a.z) {
                    if (d.y >= 0.0) {
                        face = 2;
                        u = d.x / a.y;
                        v = d.z / a.y;
                    } else {
                        face = 3;
                        u = d.x / a.y;
                        v = -d.z / a.y;
                    }
                } else {
                    if (d.z >= 0.0) {
                        face = 4;
                        u = d.x / a.z;
                        v = -d.y / a.z;
                    } else {
                        face = 5;
                        u = -d.x / a.z;
                        v = -d.y / a.z;
                    }
                }
                const int res = max(1, int(probe.weight.y));
                const vec2 texel = (vec2(u, v) * 0.5 + 0.5) * float(res) - 0.5;
                const ivec2 di0 = ivec2(floor(texel));
                const vec2 df = fract(texel);
                vec2 depthMomentSum = vec2(0.0);
                float depthWeight = 0.0;
                for (int dd = 0; dd < 4; ++dd) {
                    const int dx = dd & 1;
                    const int dy = (dd >> 1) & 1;
                    const int ix = clamp(di0.x + dx, 0, res - 1);
                    const int iy = clamp(di0.y + dy, 0, res - 1);
                    const float ww = (dx == 0 ? 1.0 - df.x : df.x) *
                                     (dy == 0 ? 1.0 - df.y : df.y);
                    const int idx = ((probeIndex * 6 + face) * res + iy) * res + ix;
                    depthMomentSum += probeDepthData.probeDepthMoments[idx] * ww;
                    depthWeight += ww;
                }
                const vec2 moments = depthWeight > 1.0e-6 ? depthMomentSum / depthWeight
                                                          : vec2(1.0e30, 1.0e30);
                const float mean = moments.x;
                const float variance = max(moments.y - mean * mean, 1.0e-4);
                const float diff = dist - mean;
                float visible = 1.0;
                if (diff > 0.0) visible = variance / (variance + diff * diff);
                w *= clamp(visible, 0.0, 1.0);
                wsum += w;
                const int base = probeIndex * 9;
                for (int k = 0; k < 9; ++k) c[k] += probeData.probeSh[base + k] * w;
            }
        }
    }
    if (wsum < 1.0e-4) return vec3(0.0);
    for (int k = 0; k < 9; ++k) c[k] /= wsum;
    const float b0 = 0.2820947918;
    const float b1 = 0.4886025119 * n.y;
    const float b2 = 0.4886025119 * n.z;
    const float b3 = 0.4886025119 * n.x;
    const float b4 = 1.0925484306 * n.x * n.y;
    const float b5 = 1.0925484306 * n.y * n.z;
    const float b6 = 0.3153915653 * (3.0 * n.z * n.z - 1.0);
    const float b7 = 1.0925484306 * n.x * n.z;
    const float b8 = 0.5462742153 * (n.x * n.x - n.y * n.y);
    vec3 irr = (3.14159265359 * b0) * c[0].rgb;
    irr += (2.0 * 3.14159265359 / 3.0) * (b1 * c[1].rgb + b2 * c[2].rgb + b3 * c[3].rgb);
    irr += (3.14159265359 / 4.0) * (b4 * c[4].rgb + b5 * c[5].rgb + b6 * c[6].rgb + b7 * c[7].rgb +
                         b8 * c[8].rgb);
    return max(irr, vec3(0.0));
}

layout(set = 0, binding = 4) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 5) readonly buffer Positions { vec4 positions[]; } posData;
layout(set = 0, binding = 6) readonly buffer Normals { vec4 normals[]; } normData;
layout(set = 0, binding = 7) readonly buffer TriMeta { uvec4 meta[]; } metaData;

const float PI = 3.14159265359;
const float EPS = 1.0e-4;
const int PT_BOUNCES = 3;

struct Hit {
    float t;
    vec3 normal;
    int material;
    bool valid;
};

uint rngStep(inout uint state) {
    state ^= state << 13;
    state ^= state >> 17;
    state ^= state << 5;
    return state;
}

float rnd(inout uint state) {
    return float(rngStep(state) & 0x00FFFFFFu) / 16777216.0;
}

vec3 skyColor(vec3 dir) {
    const float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    const vec3 horizon = vec3(0.62, 0.70, 0.82);
    const vec3 zenith = vec3(0.12, 0.30, 0.68);
    return mix(horizon, zenith, t);
}

vec3 cosineDir(vec3 n, inout uint state) {
    const float r1 = rnd(state);
    const float r2 = rnd(state);
    const float phi = 2.0 * PI * r2;
    const float radius = sqrt(r1);
    const float z = sqrt(max(0.0, 1.0 - r1));
    const vec3 up = abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3 t = normalize(cross(up, n));
    const vec3 b = cross(n, t);
    return normalize(t * cos(phi) * radius + b * sin(phi) * radius + n * z);
}

uint materialBase(int material) {
    return u.counts.x * 4u + u.counts.y * 2u + uint(material) * 2u;
}

// 一次 ray query；返回最近命中（committed）。阴影射线走 occluded()。
Hit trace(vec3 ro, vec3 rd, float tMax) {
    Hit hit;
    hit.valid = false;
    hit.t = tMax;
    hit.normal = vec3(0.0);
    hit.material = 0;
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, ro, EPS, rd, tMax);
    while (rayQueryProceedEXT(rq)) {
    }
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        return hit;
    }
    hit.t = rayQueryGetIntersectionTEXT(rq, true);
    const uint primitive = uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
    const uvec4 tri = metaData.meta[primitive];
    const vec3 p0 = posData.positions[tri.x].xyz;
    const vec3 p1 = posData.positions[tri.y].xyz;
    const vec3 p2 = posData.positions[tri.z].xyz;
    const vec3 hp = ro + rd * hit.t;
    const vec3 e0 = p1 - p0;
    const vec3 e1 = p2 - p0;
    const vec3 ep = hp - p0;
    const float d00 = dot(e0, e0);
    const float d01 = dot(e0, e1);
    const float d11 = dot(e1, e1);
    const float d20 = dot(ep, e0);
    const float d21 = dot(ep, e1);
    const float denom = d00 * d11 - d01 * d01;
    vec3 n;
    if (abs(denom) > 1.0e-12) {
        const float bv = (d11 * d20 - d01 * d21) / denom;
        const float bw = (d00 * d21 - d01 * d20) / denom;
        const float bu = 1.0 - bv - bw;
        n = normData.normals[tri.x].xyz * bu + normData.normals[tri.y].xyz * bv +
            normData.normals[tri.z].xyz * bw;
    } else {
        n = cross(e0, e1);
    }
    // 掠射/退化三角形可能给出零向量或 NaN 法线：回退到面向射线的方向，避免污染累积。
    const float nlen2 = dot(n, n);
    if (!(nlen2 > 1.0e-12) || any(isnan(n)) || any(isinf(n))) {
        n = -rd;
    } else {
        n *= inversesqrt(nlen2);
    }
    // 从内部命中背面（掠射时数值上漏掉正面）：视为 miss，避免反射链卡在球体内变纯黑。
    if (dot(n, rd) > 0.0) return hit;
    hit.normal = n;
    hit.material = int(tri.w);
    hit.valid = true;
    return hit;
}

bool occluded(vec3 ro, vec3 rd, float tMax) {
    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF,
                          ro, EPS, rd, tMax);
    while (rayQueryProceedEXT(rq)) {
    }
    return rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 shadeDirect(Hit hit, vec3 p, int lightMode) {
    const vec3 albedo = sceneData.data[materialBase(hit.material) + 0u].xyz;
    const vec3 fill = albedo * skyColor(hit.normal) * 0.22;
    vec3 result = vec3(0.0);
    if (lightMode == 0) {
        const vec3 toLight = normalize(-u.sunDir.xyz);
        const float ndl = dot(hit.normal, toLight);
        if (ndl <= 0.0) return fill;
        result = albedo * (ndl / PI * 3.0);
    } else {
        const vec3 toLight = u.lightPos.xyz - p;
        const float dist = length(toLight);
        if (dist <= EPS) return fill;
        const vec3 l = toLight / dist;
        const float ndl = dot(hit.normal, l);
        if (ndl <= 0.0) return fill;
        if (occluded(p + hit.normal * (EPS * 10.0), l, dist - EPS)) return fill;
        const float range = 9.0;
        const float att = 1.0 / (1.0 + 2.0 / range * dist + 1.0 / (range * range) * dist * dist);
        result = albedo * (ndl / PI * 3.0 * att);
    }
    return result + fill;
}

vec3 radiance(vec3 ro, vec3 rd, int lightMode, inout uint state,
              out vec3 primaryP, out bool primaryHit) {
    primaryP = vec3(0.0);
    primaryHit = false;
    vec3 result = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 currentOrigin = ro;
    vec3 currentDir = rd;
    for (int bounce = 0; bounce < PT_BOUNCES; ++bounce) {
        const Hit hit = trace(currentOrigin, currentDir, 1.0e30);
        if (!hit.valid) {
            result += throughput * skyColor(currentDir);
            break;
        }
        const vec3 p = currentOrigin + currentDir * hit.t;
        const vec3 albedo = sceneData.data[materialBase(hit.material) + 0u].xyz;
        const float metallic = sceneData.data[materialBase(hit.material) + 0u].w;
        if (metallic > 0.5) {
            currentOrigin = p + hit.normal * (EPS * 10.0);
            currentDir = normalize(reflect(currentDir, hit.normal));
            throughput *= albedo;
            continue;
        }
        const vec3 direct = shadeDirect(hit, p, lightMode);
        if (!any(isnan(direct)) && !any(isinf(direct))) result += throughput * direct;
        if (probe.weight.x > 0.5) {
            // 探针只烘间接光；直接光在上一步加，跳过第 2/3 次漫反射射线。
            const vec3 indirect = evalProbeSh(p, hit.normal);
            result += throughput * albedo * indirect * 0.31830988618;
            break;
        }
        currentOrigin = p + hit.normal * (EPS * 10.0);
        currentDir = cosineDir(hit.normal, state);
        throughput *= albedo;
        if (bounce >= 2) {
            const float survive = 0.8;
            if (rnd(state) > survive) break;
            throughput *= 1.0 / survive;
        }
    }
    if (any(isnan(result)) || any(isinf(result))) return vec3(0.0);
    return clamp(result, vec3(0.0), vec3(1.0e4));
}

float toLinearByte(float value) {
    value = (value * (2.51 * value + 0.03)) / (value * (2.43 * value + 0.59) + 0.14);
    value = clamp(value, 0.0, 1.0);
    return pow(value, 1.0 / 2.2);
}

uint packRgba(vec3 color) {
    const uint r = uint(toLinearByte(color.r) * 255.0 + 0.5);
    const uint g = uint(toLinearByte(color.g) * 255.0 + 0.5);
    const uint b = uint(toLinearByte(color.b) * 255.0 + 0.5);
    return r | (g << 8) | (b << 16) | (255u << 24);
}

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    const int width = int(u.size.x);
    const int height = int(u.size.y);
    if (int(pixel.x) >= width || int(pixel.y) >= height) return;

    const vec3 eye = u.eye.xyz;
    const vec3 forward = normalize(u.fwd.xyz);
    const vec3 rightDir = normalize(u.camRight.xyz);
    const vec3 upDir = normalize(u.camUp.xyz);
    const float tanHalf = u.cam.x;
    const float aspect = u.cam.y;
    const int lightMode = int(u.cam.z);
    const int sampleCount = int(u.cam.w);

    const uint pixelIndex = pixel.y * uint(width) + pixel.x;
    const uint seed = uint(pixel.x) * 1973u + uint(pixel.y) * 9277u + 17u;
    const uint frameStart = uint(u.accumParams.x);
    vec3 sum = vec3(0.0);
    vec3 primaryP = vec3(0.0);
    bool primaryHit = false;
    for (int s = 0; s < sampleCount; ++s) {
        uint state = seed + (frameStart + uint(s)) * 0x9E3779B9u;
        if (state == 0u) state = 1u;
        const float jx = rnd(state);
        const float jy = rnd(state);
        const float uu = (float(pixel.x) + jx) / float(width);
        const float vv = (float(pixel.y) + jy) / float(height);
        const vec3 dir = normalize(forward + rightDir * ((2.0 * uu - 1.0) * tanHalf * aspect) +
                                   upDir * ((1.0 - 2.0 * vv) * tanHalf));
        vec3 p = vec3(0.0);
        bool hit = false;
        sum += radiance(eye, dir, lightMode, state, p, hit);
        if (s == 0) { primaryP = p; primaryHit = hit; }
    }
    vec3 color = sum / float(sampleCount);

    vec2 prevUV = vec2(0.0);
    float zPrev = 0.0;
    bool histOk = primaryHit && u.temporal.x > 0.5;
    if (histOk) {
        const vec3 d = primaryP - u.prevEye.xyz;
        zPrev = dot(d, u.prevFwd.xyz);
        if (zPrev <= 1.0e-4) {
            histOk = false;
        } else {
            const vec2 ndc = vec2(dot(d, u.prevRight.xyz) / (zPrev * tanHalf * aspect),
                                  dot(d, u.prevUp.xyz) / (zPrev * tanHalf));
            prevUV = vec2(0.5 + 0.5 * ndc.x, 0.5 - 0.5 * ndc.y);
            histOk = all(greaterThanEqual(prevUV, vec2(0.0))) &&
                     all(lessThanEqual(prevUV, vec2(1.0)));
        }
    }

    vec4 histColor = vec4(0.0);
    float histDepth = 1.0e30;
    if (histOk) {
        const vec2 texel = prevUV * u.size.xy - 0.5;
        const ivec2 i0 = ivec2(floor(texel));
        const vec2 f = fract(texel);
        const int iw = int(u.size.x);
        const int ih = int(u.size.y);
        vec4 c = vec4(0.0);
        float dsum = 0.0;
        float wsum = 0.0;
        for (int y = 0; y < 2; ++y) {
            for (int x = 0; x < 2; ++x) {
                const int ix = clamp(i0.x + x, 0, iw - 1);
                const int iy = clamp(i0.y + y, 0, ih - 1);
                const float wx = (x == 0) ? (1.0 - f.x) : f.x;
                const float wy = (y == 0) ? (1.0 - f.y) : f.y;
                const float ww = wx * wy;
                const int idx = iy * iw + ix;
                c += historyIn.historyColorIn[idx] * ww;
                dsum += depthIn.historyDepthIn[idx] * ww;
                wsum += ww;
            }
        }
        if (wsum > 1.0e-6) {
            histColor = c / wsum;
            histDepth = dsum / wsum;
            if (abs(zPrev - histDepth) > max(0.05 * zPrev, 0.05)) histOk = false;
        }
    }

    float newCount = 1.0;
    if (histOk) {
        if (u.temporal.y > 0.5) {
            color = mix(histColor.rgb, color, 0.15);
            newCount = 1.0;
        } else {
            const float n = clamp(histColor.a, 1.0, 1024.0);
            const float alpha = 1.0 / (n + 1.0);
            color = mix(histColor.rgb, color, alpha);
            newCount = min(n + 1.0, 1024.0);
        }
    }
    historyOut.historyColorOut[pixelIndex] = vec4(color, newCount);
    const float zCur = primaryHit ? dot(primaryP - eye, forward) : 1.0e30;
    depthOut.historyDepthOut[pixelIndex] = zCur;
    outBuf.pixels[pixelIndex] = packRgba(color);
}
